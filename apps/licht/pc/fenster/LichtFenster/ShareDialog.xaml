<!-- Sharing lamps with another Licht: a QR code. DataContext: ShareViewModel (Licht.Fenster.Core). -->
<UserControl x:Class="LichtFenster.ShareDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LichtFenster">
  <StackPanel MinWidth="300">
    <TextBlock Style="{StaticResource DialogTitle}" Text="{Binding Title}" />

    <StackPanel Orientation="Horizontal" Margin="0,18,0,6" Visibility="{Binding Preparing, Converter={StaticResource VisibleIf}}">
      <local:Spinner />
      <TextBlock Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center"
                 Text="Der Code wird vorbereitet – die Lampen werden zum Teilen geöffnet …" />
    </StackPanel>

    <StackPanel Visibility="{Binding HasCode, Converter={StaticResource VisibleIf}}">
      <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                 Text="Auf dem anderen Gerät in Licht „Lampe hinzufügen → QR-Code scannen“ wählen – die Lampen müssen dort nicht neu eingerichtet werden. Ein PC ohne Kamera: „Code kopieren“ und dort unter „Lampe hinzufügen“ einfügen." />
      <local:QrView x:Name="Code" Matrix="{Binding Matrix}" MaxSize="300" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="QR-Code zum Teilen" />
      <TextBlock Text="{Binding LampsText}" TextWrapping="Wrap" Margin="0,14,0,0" />
      <TextBlock Text="{Binding SkippedText}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,6,0,0"
                 Visibility="{Binding SkippedText, Converter={StaticResource VisibleIfAny}}" />
      <TextBlock Text="{Binding FullText}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,6,0,0"
                 Visibility="{Binding FullText, Converter={StaticResource VisibleIfAny}}" />
      <TextBlock Style="{StaticResource SmallText}" Text="{Binding ValidText}" Margin="0,6,0,0" />
      <StackPanel Visibility="{Binding ManualCode, Converter={StaticResource VisibleIfAny}}" Margin="0,14,0,0">
        <TextBlock Style="{StaticResource SmallText}" Text="Für andere Matter-Apps (z. B. SMART+) stattdessen diese Ziffern eingeben:" />
        <TextBox Style="{StaticResource CodeText}" Text="{Binding ManualCode, Mode=OneWay}" Margin="0,6,0,0"
                 AutomationProperties.Name="Code mit Ziffern" />
      </StackPanel>
    </StackPanel>

    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource VisibleIfAny}}"
               AutomationProperties.AutomationId="Fehler" />

    <StackPanel Style="{StaticResource DialogButtons}">
      <Button Style="{StaticResource Btn.Ghost}" Content="Verbundene Apps …" Command="{Binding ConnectionsCommand}" Margin="0,0,8,0"
              Visibility="{Binding CanOpenConnections, Converter={StaticResource VisibleIf}}" />
      <Button Style="{StaticResource Btn.Ghost}" Content="Code kopieren" Command="{Binding CopyCommand}" Margin="0,0,8,0"
              Visibility="{Binding HasCode, Converter={StaticResource VisibleIf}}"
              ToolTip="Den Code als Text kopieren – zum Einfügen in Licht auf einem anderen PC." />
      <Button x:Name="DoneButton" Style="{StaticResource Btn.Primary}" Content="Fertig" Click="DoneClick" MinWidth="88" />
    </StackPanel>
  </StackPanel>
</UserControl>
