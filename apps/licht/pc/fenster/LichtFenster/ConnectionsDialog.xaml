<!-- "Verbundene Apps" of a lamp. DataContext: ConnectionsViewModel (Licht.Fenster.Core). -->
<UserControl x:Class="LichtFenster.ConnectionsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LichtFenster">
  <StackPanel MinWidth="300">
    <TextBlock Style="{StaticResource DialogTitle}" Text="{Binding Title}" />
    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
               Text="Diese Apps dürfen die Lampe steuern. Eine Lampe nimmt nur wenige auf – ist sie voll, kann kein weiteres Gerät sie hinzufügen. Einträge von Apps, die du nicht mehr benutzt (z. B. eine frühere Installation von Licht), kannst du hier entfernen." />

    <StackPanel Orientation="Horizontal" Margin="0,16,0,4" Visibility="{Binding Loading, Converter={StaticResource VisibleIf}}">
      <local:Spinner />
      <TextBlock Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center" Text="Die Lampe wird gefragt …" />
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Items}" Margin="0,14,0,0" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
              <Button x:Name="RemoveButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Outline}" Content="Entfernen"
                      Foreground="{DynamicResource Danger}" VerticalAlignment="Center" Margin="10,0,0,0"
                      Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} entfernen'}" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Detail" Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Own}" Value="True">
              <Setter TargetName="RemoveButton" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource Accent}" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,6,0,0"
               Visibility="{Binding SummaryText, Converter={StaticResource VisibleIfAny}}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource Muted}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsFull}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding Busy, Converter={StaticResource VisibleIf}}">
      <local:Spinner />
      <TextBlock Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding BusyText}" />
    </StackPanel>
    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource VisibleIfAny}}"
               AutomationProperties.AutomationId="Fehler" />

    <StackPanel Style="{StaticResource DialogButtons}">
      <Button x:Name="DoneButton" Style="{StaticResource Btn.Primary}" Content="Fertig" Click="DoneClick" MinWidth="88" />
    </StackPanel>
  </StackPanel>
</UserControl>
