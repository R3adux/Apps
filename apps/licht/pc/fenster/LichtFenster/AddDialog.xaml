<!-- "Lampe hinzufügen". DataContext: AddViewModel (Licht.Fenster.Core). -->
<UserControl x:Class="LichtFenster.AddDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LichtFenster">
  <StackPanel>
    <TextBlock Style="{StaticResource DialogTitle}" Text="Lampe hinzufügen" />
    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
               Text="Den Matter-Code findest du auf der Lampe oder der Verpackung (11 Ziffern, z. B. 3497-011-2332). Ist die Lampe schon in einer anderen App (z. B. SMART+), erzeuge dort einen Code zum Teilen." />
    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
               Text="Hat ein anderes Licht seine Lampen geteilt: den kopierten Code (beginnt mit MT:) hier einfügen – alle Lampen darin kommen auf einmal dazu." />

    <TextBlock Style="{StaticResource FieldLabel}" Text="Code" />
    <TextBox x:Name="CodeBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
             IsEnabled="{Binding Busy, Converter={StaticResource Not}}" MaxLength="4000"
             AutomationProperties.Name="Code" KeyDown="CodeKeyDown" />

    <DockPanel Margin="0,12,0,0">
      <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Outline}" Content="Im Netz suchen" Command="{Binding SearchCommand}"
              VerticalAlignment="Center" />
      <TextBlock Style="{StaticResource SmallText}" Text="zeigt, ob die Lampe gerade bereit zum Hinzufügen ist" Margin="10,0,0,0" VerticalAlignment="Center" />
    </DockPanel>

    <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="12,10" Margin="0,10,0,0"
            Visibility="{Binding ShowSearchResult, Converter={StaticResource VisibleIf}}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Visibility="{Binding Searching, Converter={StaticResource VisibleIf}}">
          <local:Spinner Size="14" />
          <TextBlock Text="Suche … (einige Sekunden)" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding SearchText}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="{Binding SearchText, Converter={StaticResource VisibleIfAny}}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Searching}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Found}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,2,0,4">
                <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding MatchesCode}" Value="True">
                  <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Expander Style="{StaticResource Disclosure}" Header="Erweitert" Margin="0,14,0,0">
      <StackPanel>
        <TextBlock Style="{StaticResource FieldLabel}" Text="IP-Adresse der Lampe (optional, nur falls die Suche sie nicht findet)" Margin="0,10,0,6" />
        <TextBox Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Busy, Converter={StaticResource Not}}"
                 MaxLength="64" AutomationProperties.Name="IP-Adresse" KeyDown="CodeKeyDown" />
      </StackPanel>
    </Expander>

    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding ProgressText, Converter={StaticResource VisibleIfAny}}">
      <local:Spinner />
      <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource VisibleIfAny}}"
               AutomationProperties.AutomationId="Fehler" />

    <StackPanel Style="{StaticResource DialogButtons}">
      <Button x:Name="CloseButton" Margin="0,0,8,0" Click="CloseClick">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Content" Value="Abbrechen" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Busy}" Value="True">
                <Setter Property="Content" Value="Im Hintergrund weiter" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Style="{StaticResource Btn.Primary}" Content="Hinzufügen" Command="{Binding SubmitCommand}" MinWidth="110" />
    </StackPanel>
  </StackPanel>
</UserControl>
