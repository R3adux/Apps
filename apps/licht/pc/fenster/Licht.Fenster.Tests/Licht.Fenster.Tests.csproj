<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the window's logic (Licht.Fenster.Core); run on any system: dotnet test -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Tests use their own short timeouts instead of TestContext cancellation. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <!-- Reads the QR codes back, to check them (Apache 2.0). -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Licht.Fenster.Core\Licht.Fenster.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
