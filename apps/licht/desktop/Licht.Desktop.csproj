<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Licht's Windows desktop part: tray icon + the small Licht window (the same web UI as in the browser,
    shown with Edge WebView2). Started and ended by Licht.exe, which embeds this program's files.

    .NET Framework 4.8 and the WebView2 runtime come with Windows 10/11, so nothing has to be installed
    and the files stay small (about 1 MB). Build: dotnet build -c Release (also works on Linux).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>LichtFenster</AssemblyName>
    <RootNamespace>Licht.Desktop</RootNamespace>
    <ApplicationIcon>licht.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Licht</AssemblyTitle>
    <Product>Licht</Product>
    <Description>Licht – Fenster und Symbol in der Taskleiste</Description>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- licht.ico is made from ../web/icon.svg (small sizes as bitmaps, 256 px as PNG). -->
    <EmbeddedResource Include="licht.ico" LogicalName="licht.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- Reference assemblies, so this also builds on Linux/macOS (CI, development). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
