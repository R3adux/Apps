<Project Sdk="Microsoft.NET.Sdk">
  <!-- Local web server: web UI, phone deck, JSON/WebSocket API for the Stream Deck plugin.
       No Windows code, so it is tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Stratagem.Core\Stratagem.Core.csproj" />
    <EmbeddedResource Include="..\..\web\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
