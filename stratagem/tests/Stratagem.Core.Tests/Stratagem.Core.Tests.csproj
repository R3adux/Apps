<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Tests use their own short timeouts instead of TestContext cancellation. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Stratagem.Core\Stratagem.Core.csproj" />
    <ProjectReference Include="..\..\src\Stratagem.Server\Stratagem.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- input_settings.real.config: a real file from the game (bindings only, nothing personal). -->
    <None Include="data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
