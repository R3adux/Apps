{
  "name": "licht-android",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build-web": "node scripts/build-web.mjs",
    "bundle": "node scripts/build-web.mjs && react-native bundle --platform android --dev false --entry-file index.js --bundle-output /tmp/licht.bundle",
