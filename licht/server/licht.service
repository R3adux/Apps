# systemd unit for the Raspberry Pi (or any Linux box).
# Install: sudo cp server/licht.service /etc/systemd/system/ && sudo systemctl enable --now licht
[Unit]
Description=Licht – lokale Lampensteuerung (Matter)
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Apps/licht
ExecStart=/usr/bin/node server/main.js
Environment=PORT=8080
# Environment=LICHT_BLE=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
